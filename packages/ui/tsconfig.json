{
  "compilerOptions": {
    "target": "ES2020", "lib": ["DOM", "DOM.Iterable", "ES2020"], "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "skipLibCheck": true, "noEmit": true, "isolatedModules": true,
    "paths": {
      "react": ["../../apps/web/node_modules/@types/react"],
